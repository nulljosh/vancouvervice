; Pause menu body for BP_VVHud, spliced into hud.dsl at its @include line by write_dsl.py (one graph, two files
; to stay under the repo's per-file token limit). See hud.dsl for the layout notes.
        (bind x0 (* SizeX 0.1))
        (bind tw (* SizeX 0.16))
        (bind ty (* SizeY 0.15))
        (bind cy (+ ty (* SizeY 0.07)))
        (bind cw (* SizeX 0.8))
        (bind ch (* SizeY 0.62))
        (HUD|DrawRect :RectColor "(R=0.000000,G=0.000000,B=0.000000,A=0.720000)" :ScreenX 0.0 :ScreenY 0.0 :ScreenW SizeX :ScreenH SizeY)
        (HUD|DrawText :Text "Vancouver Vice" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX x0 :ScreenY (* SizeY 0.045) :Font "/Game/VancouverVice/HUD/F_Seawall.F_Seawall" :Scale 1.05)
        (HUD|DrawText :Text "JOSHUA" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (- (* SizeX 0.9) 110.0) :ScreenY (* SizeY 0.05) :Font "/Game/VancouverVice/HUD/F_Seawall.F_Seawall" :Scale 0.6)
        (HUD|DrawText :Text (Utilities|String|Append "MISSION " (Utilities|String|Append (Utilities|String|ToString(Integer) (Math|Integer|Min(Integer) (+ idx 1) nmiss)) (Utilities|String|Append " OF " (Utilities|String|ToString(Integer) nmiss))))
          :TextColor "(R=0.800000,G=0.800000,B=0.820000,A=1.000000)" :ScreenX (- (* SizeX 0.9) 110.0) :ScreenY (+ (* SizeY 0.05) 34.0) :Scale 1.1)
        ; tab bar
        (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY ty :ScreenW (- tw 3.0) :ScreenH (* SizeY 0.05))
        (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX (+ x0 tw) :ScreenY ty :ScreenW (- tw 3.0) :ScreenH (* SizeY 0.05))
        (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX (+ x0 (* 2.0 tw)) :ScreenY ty :ScreenW (- tw 3.0) :ScreenH (* SizeY 0.05))
        (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX (+ x0 (* 3.0 tw)) :ScreenY ty :ScreenW (- tw 3.0) :ScreenH (* SizeY 0.05))
        (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX (+ x0 (* 4.0 tw)) :ScreenY ty :ScreenW (- tw 3.0) :ScreenH (* SizeY 0.05))
        (HUD|DrawRect :RectColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 (* tab tw)) :ScreenY ty :ScreenW (- tw 3.0) :ScreenH (* SizeY 0.05))
        (HUD|DrawRect :RectColor "(R=0.745000,G=0.036000,B=0.025000,A=1.000000)" :ScreenX (+ x0 (* tab tw)) :ScreenY (- ty 5.0) :ScreenW (- tw 3.0) :ScreenH 5.0)
        (HUD|DrawText :Text "MAP" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 16.0) :ScreenY (+ ty 8.0) :Font "/Game/VancouverVice/HUD/F_Seawall.F_Seawall" :Scale 0.45)
        (HUD|DrawText :Text "BRIEF" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ (+ x0 tw) 16.0) :ScreenY (+ ty 8.0) :Font "/Game/VancouverVice/HUD/F_Seawall.F_Seawall" :Scale 0.45)
        (HUD|DrawText :Text "STATS" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ (+ x0 (* 2.0 tw)) 16.0) :ScreenY (+ ty 8.0) :Font "/Game/VancouverVice/HUD/F_Seawall.F_Seawall" :Scale 0.45)
        (HUD|DrawText :Text "SETTINGS" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ (+ x0 (* 3.0 tw)) 16.0) :ScreenY (+ ty 8.0) :Font "/Game/VancouverVice/HUD/F_Seawall.F_Seawall" :Scale 0.45)
        (HUD|DrawText :Text "GAME" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ (+ x0 (* 4.0 tw)) 16.0) :ScreenY (+ ty 8.0) :Font "/Game/VancouverVice/HUD/F_Seawall.F_Seawall" :Scale 0.45)
        (HUD|DrawText :Text (select (== tab 0) "MAP" (select (== tab 1) "BRIEF" (select (== tab 2) "STATS" (select (== tab 3) "SETTINGS" "GAME"))))
          :TextColor "(R=0.000000,G=0.000000,B=0.000000,A=1.000000)" :ScreenX (+ (+ x0 (* tab tw)) 16.0) :ScreenY (+ ty 8.0) :Font "/Game/VancouverVice/HUD/F_Seawall.F_Seawall" :Scale 0.45)
        ; content
        (if (== tab 0)
          (bind ms (/ ch 512.0))
          (bind mx (+ x0 (* 0.5 (- cw ch))))
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY cy :ScreenW cw :ScreenH ch)
          (HUD|DrawTextureSimple :Texture "/Game/VancouverVice/HUD/RT_Minimap.RT_Minimap" :ScreenX mx :ScreenY cy :Scale ms)
          (HUD|DrawRect :RectColor "(R=1.000000,G=0.800000,B=0.050000,A=1.000000)"
            :ScreenX (Math|Float|Clamp(Float) (+ (+ mx (* 0.5 ch)) (* (/ ch 30000.0) (- (.y goal) (.y pawnloc)))) mx (- (+ mx ch) 14.0))
            :ScreenY (Math|Float|Clamp(Float) (+ (+ cy (* 0.5 ch)) (* (/ ch -30000.0) (- (.x goal) (.x pawnloc)))) cy (- (+ cy ch) 14.0))
            :ScreenW 14.0 :ScreenH 14.0)
          (HUD|DrawRect :RectColor "(R=0.710000,G=0.314000,B=0.173000,A=1.000000)" :ScreenX (- (+ mx (* 0.5 ch)) 6.0) :ScreenY (- (+ cy (* 0.5 ch)) 6.0) :ScreenW 12.0 :ScreenH 12.0))
        (if (== tab 1)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY cy :ScreenW cw :ScreenH 50.0)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY (+ cy 53.0) :ScreenW cw :ScreenH 50.0)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY (+ cy 106.0) :ScreenW cw :ScreenH 50.0)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY (+ cy 159.0) :ScreenW cw :ScreenH 50.0)
          (HUD|DrawText :Text (Utilities|Array|Get(acopy) names 0) :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 14.0) :Scale 1.4)
          (HUD|DrawText :Text (Utilities|Array|Get(acopy) names 1) :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 67.0) :Scale 1.4)
          (HUD|DrawText :Text (Utilities|Array|Get(acopy) names 2) :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 120.0) :Scale 1.4)
          (HUD|DrawText :Text (Utilities|Array|Get(acopy) names 3) :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 173.0) :Scale 1.4)
          (if (< idx nmiss)
            (HUD|DrawRect :RectColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX x0 :ScreenY (+ cy (* 53.0 idx)) :ScreenW cw :ScreenH 50.0)
            (HUD|DrawText :Text (Utilities|Array|Get(acopy) names idx) :TextColor "(R=0.000000,G=0.000000,B=0.000000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ (+ cy (* 53.0 idx)) 14.0) :Scale 1.4)))
        (if (== tab 2)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY cy :ScreenW cw :ScreenH 50.0)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY (+ cy 53.0) :ScreenW cw :ScreenH 50.0)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY (+ cy 106.0) :ScreenW cw :ScreenH 50.0)
          (HUD|DrawText :Text "Health" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 14.0) :Scale 1.4)
          (HUD|DrawText :Text "Wanted level" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 67.0) :Scale 1.4)
          (HUD|DrawText :Text "Missions passed" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 120.0) :Scale 1.4)
          (HUD|DrawRect :RectColor "(R=0.090000,G=0.200000,B=0.110000,A=1.000000)" :ScreenX (+ x0 (* 0.5 cw)) :ScreenY (+ cy 20.0) :ScreenW (* 0.45 cw) :ScreenH 10.0)
          (HUD|DrawRect :RectColor "(R=0.300000,G=0.700000,B=0.330000,A=1.000000)" :ScreenX (+ x0 (* 0.5 cw)) :ScreenY (+ cy 20.0) :ScreenW (* (* 0.0045 cw) (Math|Float|Clamp(Float) (Class|BPMissions|GetHealth m) 0.0 100.0)) :ScreenH 10.0)
          (HUD|DrawText :Text (Utilities|String|ToString(Integer) stars) :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 (* 0.5 cw)) :ScreenY (+ cy 67.0) :Scale 1.4)
          (HUD|DrawText :Text (Utilities|String|Append (Utilities|String|ToString(Integer) (Math|Integer|Min(Integer) idx nmiss)) (Utilities|String|Append " of " (Utilities|String|ToString(Integer) nmiss)))
            :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 (* 0.5 cw)) :ScreenY (+ cy 120.0) :Scale 1.4))
        (if (== tab 3)
          (HUD|DrawRect :RectColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX x0 :ScreenY cy :ScreenW (* 0.3 cw) :ScreenH 50.0)
          (HUD|DrawText :Text "Controls" :TextColor "(R=0.000000,G=0.000000,B=0.000000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 14.0) :Scale 1.4)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX (+ x0 (* 0.31 cw)) :ScreenY cy :ScreenW (* 0.69 cw) :ScreenH 265.0)
          (HUD|DrawText :Text "Move               W A S D" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 (+ (* 0.31 cw) 20.0)) :ScreenY (+ cy 14.0) :Scale 1.4)
          (HUD|DrawText :Text "Look               Mouse" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 (+ (* 0.31 cw) 20.0)) :ScreenY (+ cy 64.0) :Scale 1.4)
          (HUD|DrawText :Text "Enter / exit car   E" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 (+ (* 0.31 cw) 20.0)) :ScreenY (+ cy 114.0) :Scale 1.4)
          (HUD|DrawText :Text "Punch              F or left click" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 (+ (* 0.31 cw) 20.0)) :ScreenY (+ cy 164.0) :Scale 1.4)
          (HUD|DrawText :Text "Pause              Esc" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 (+ (* 0.31 cw) 20.0)) :ScreenY (+ cy 214.0) :Scale 1.4))
        (if (== tab 4)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY cy :ScreenW (* 0.3 cw) :ScreenH 50.0)
          (HUD|DrawRect :RectColor "(R=0.007500,G=0.008500,B=0.012300,A=0.820000)" :ScreenX x0 :ScreenY (+ cy 53.0) :ScreenW (* 0.3 cw) :ScreenH 50.0)
          (HUD|DrawText :Text "Resume" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 14.0) :Scale 1.4)
          (HUD|DrawText :Text "Quit Game" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ cy 67.0) :Scale 1.4)
          (HUD|DrawRect :RectColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX x0 :ScreenY (+ cy (* 53.0 sel)) :ScreenW (* 0.3 cw) :ScreenH 50.0)
          (HUD|DrawText :Text (select (== sel 0) "Resume" "Quit Game") :TextColor "(R=0.000000,G=0.000000,B=0.000000,A=1.000000)" :ScreenX (+ x0 20.0) :ScreenY (+ (+ cy (* 53.0 sel)) 14.0) :Scale 1.4))
        ; key hints
        (HUD|DrawRect :RectColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (- SizeX 420.0) :ScreenY (- SizeY 64.0) :ScreenW 62.0 :ScreenH 26.0)
        (HUD|DrawText :Text "ENTER" :TextColor "(R=0.000000,G=0.000000,B=0.000000,A=1.000000)" :ScreenX (- SizeX 412.0) :ScreenY (- SizeY 60.0) :Scale 1.2)
        (HUD|DrawText :Text "Select" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (- SizeX 350.0) :ScreenY (- SizeY 60.0) :Scale 1.2)
        (HUD|DrawRect :RectColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (- SizeX 275.0) :ScreenY (- SizeY 64.0) :ScreenW 44.0 :ScreenH 26.0)
        (HUD|DrawText :Text "ESC" :TextColor "(R=0.000000,G=0.000000,B=0.000000,A=1.000000)" :ScreenX (- SizeX 267.0) :ScreenY (- SizeY 60.0) :Scale 1.2)
        (HUD|DrawText :Text "Back" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (- SizeX 223.0) :ScreenY (- SizeY 60.0) :Scale 1.2)
        (HUD|DrawRect :RectColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (- SizeX 160.0) :ScreenY (- SizeY 64.0) :ScreenW 44.0 :ScreenH 26.0)
        (HUD|DrawText :Text "A D" :TextColor "(R=0.000000,G=0.000000,B=0.000000,A=1.000000)" :ScreenX (- SizeX 152.0) :ScreenY (- SizeY 60.0) :Scale 1.2)
        (HUD|DrawText :Text "Tab" :TextColor "(R=0.896000,G=0.879000,B=0.839000,A=1.000000)" :ScreenX (- SizeX 108.0) :ScreenY (- SizeY 60.0) :Scale 1.2)
